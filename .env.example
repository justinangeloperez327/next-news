# Obtain your own key from https://gnews.io/
# This value is server-only. NEVER use NEXT_PUBLIC_ for API credentials.
# Free GNews accounts are for development/testing and have delayed results.
GNEWS_API_KEY=

# Optional editorial curation by publisher URL hostname.
# Use bare domains only, comma-separated; subdomains also match.
# Empty allow list permits all publishers except those blocked.
NEWS_ALLOWED_DOMAINS=
NEWS_BLOCKED_DOMAINS=
