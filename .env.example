# Obtain a key from https://gnews.io/
# Server-side only. NEVER prefix credentials with NEXT_PUBLIC_.
GNEWS_API_KEY=

# Optional source curation. Comma-separated hostnames (not URLs).
NEWS_ALLOWED_DOMAINS=
NEWS_BLOCKED_DOMAINS=

# Optional shared quota admission guard for multiple deployments/instances.
# Use ONE shared Redis database for all deployments using the same GNews key.
# Set both Upstash values together. Partial/invalid configuration fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Conservative defaults for the GNews Free tier: 90 requests/day, 1/second.
# Raise only to values permitted by your paid plan.
NEWS_DAILY_REQUEST_BUDGET=90
NEWS_PER_SECOND_BUDGET=1
